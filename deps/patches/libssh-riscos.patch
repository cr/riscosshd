+#ifdef __riscos__
+/* libssh leaves both rename requests unimplemented.  SSH_FXP_RENAME
+ * (filexfer v3) must fail when the target exists; posix-rename@openssh.com
+ * must replace it.  rename() through UnixLib does the work either way. */
 static int
+do_rename(sftp_client_message client_msg, int replace)
+{
+    const char *oldpath = sftp_client_message_get_filename(client_msg);
+    const char *newpath_in = sftp_client_message_get_data(client_msg);
+    char newpath[PATH_MAX];
+    struct stat st;
+    int newtype;
+    if (oldpath == NULL || newpath_in == NULL) {
+        sftp_reply_status(client_msg, SSH_FX_FAILURE, "File name error");
+        return SSH_OK;
+    }
+    snprintf(newpath, sizeof newpath, "%s", newpath_in);
+    newtype = riscos_sftp_strip_suffix(newpath);      /* "name,ffb" also retypes */
+    if (strcmp(oldpath, newpath) == 0) {              /* same name: only the type changes */
+        if (newtype >= 0)
+            riscos_sftp_set_type(newpath, newtype);
+        sftp_reply_status(client_msg, SSH_FX_OK, NULL);
+        return SSH_OK;
+    }
+    if (lstat(newpath, &st) == 0) {
+        if (!replace) {
+            sftp_reply_status(client_msg, SSH_FX_FAILURE, "Target exists");
+            return SSH_OK;
+        }
+        if (!S_ISDIR(st.st_mode))
+            unlink(newpath);
+    }
+    if (rename(oldpath, newpath) < 0) {
+        int saved_errno = errno;
+        sftp_reply_status(client_msg, unix_errno_to_ssh_stat(saved_errno), strerror(saved_errno));
+        return SSH_OK;
+    }
+    if (newtype >= 0)
+        riscos_sftp_set_type(newpath, newtype);
+    sftp_reply_status(client_msg, SSH_FX_OK, NULL);
+    return SSH_OK;
+}
+
+static int
+process_rename_riscos(sftp_client_message client_msg)
+{
+    return do_rename(client_msg, 0);
+}
+
+static int
+process_posix_rename_riscos(sftp_client_message client_msg)
+{
+    return do_rename(client_msg, 1);
+}
+
+/* SSH_FXP_FSTAT: attributes of an open handle. */
+static int
+process_fstat_riscos(sftp_client_message client_msg)
+{
+    struct sftp_handle *h = sftp_handle(client_msg->sftp, client_msg->handle);
+    struct sftp_attributes_struct attr;
+    struct stat st;
+    if (h == NULL || h->type != SFTP_FILE_HANDLE || h->fd < 0) {
+        sftp_reply_status(client_msg, SSH_FX_INVALID_HANDLE, NULL);
+        return SSH_OK;
+    }
+    if (fstat(h->fd, &st) < 0) {
+        int saved_errno = errno;
+        sftp_reply_status(client_msg, unix_errno_to_ssh_stat(saved_errno), NULL);
+        return SSH_OK;
+    }
+    stat_to_filexfer_attrib(&st, &attr);
+    sftp_reply_attr(client_msg, &attr);
+    return SSH_OK;
+}
+
+static int
+process_fsetstat_riscos(sftp_client_message client_msg)
+{
+    /* Permissions, owner and times cannot be applied on RISC OS; a size
+     * change through a handle is rare (sftp "put" never sends one). */
+    sftp_reply_status(client_msg, SSH_FX_OK, NULL);
+    return SSH_OK;
+}
