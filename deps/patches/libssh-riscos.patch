+/* Close and free every open handle of a server session.  sftp_server_free()
+ * only frees the handle table, which would leave the files open. */
+LIBSSH_API void sftp_server_close_handles(sftp_session sftp);
+void sftp_server_close_handles(sftp_session sftp)
+{
+    if (sftp == NULL || sftp->handles == NULL)
+        return;
+    for (int i = 0; i < SFTP_HANDLES; i++) {
+        struct sftp_handle *h = sftp->handles[i];
+        if (h == NULL)
+            continue;
+        if (h->type == SFTP_FILE_HANDLE && h->fd >= 0)
+            close(h->fd);
+        else if (h->type == SFTP_DIR_HANDLE && h->dirp != NULL)
+            closedir(h->dirp);
+        free(h->name);
+        free(h);
+        sftp->handles[i] = NULL;
+    }
+}
