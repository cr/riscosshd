+/* libssh leaves both rename requests unimplemented.  SSH_FXP_RENAME
+ * (filexfer v3) must fail when the target exists; posix-rename@openssh.com
+ * must replace it.  rename() through UnixLib does the work either way.
+ *
+ * RISC OS names ignore case, and listings show typed files as "name,xxx",
+ * so two different strings can name one file: "rt,ffb" and "rt,fff",
+ * "readme" and "README", "a" and "./a".  Nothing is deleted before the
+ * rename has worked: a target to be replaced is moved aside first and
+ * restored if the rename fails, so whatever the names, no file is lost. */
+static int
+do_rename(sftp_client_message client_msg, int replace)
+{
+    const char *oldpath = sftp_client_message_get_filename(client_msg);
+    const char *newpath_in = sftp_client_message_get_data(client_msg);
+    char newpath[PATH_MAX], oldbare[PATH_MAX], aside[PATH_MAX];
+    struct stat st;
+    int newtype;
+    if (oldpath == NULL || newpath_in == NULL) {
+        sftp_reply_status(client_msg, SSH_FX_FAILURE, "File name error");
+        return SSH_OK;
     }
+    if (lstat(oldpath, &st) < 0)
+        return reply_errno(client_msg, errno);
+    snprintf(newpath, sizeof newpath, "%s", newpath_in);
+    newtype = riscos_sftp_strip_suffix(newpath);      /* "name,ffb" also retypes */
+    snprintf(oldbare, sizeof oldbare, "%s", oldpath);
+    riscos_sftp_strip_suffix(oldbare);
+    if (strcasecmp(oldbare, newpath) == 0) {          /* one file: case and type only */
+        if (strcmp(oldbare, newpath) != 0 && rename(oldpath, newpath) < 0)
+            return reply_errno(client_msg, errno);
+        if (newtype >= 0)
+            riscos_sftp_set_type(newpath, newtype);
+        sftp_reply_status(client_msg, SSH_FX_OK, NULL);
+        return SSH_OK;
+    }
+    aside[0] = '\0';
+    if (lstat(newpath, &st) == 0) {
+        if (!replace) {
+            sftp_reply_status(client_msg, SSH_FX_FAILURE, "Target exists");
+            return SSH_OK;
+        }
+        if (snprintf(aside, sizeof aside, "%s~sshd", newpath) >= (int)sizeof aside ||
+            rename(newpath, aside) < 0) {
+            sftp_reply_status(client_msg, SSH_FX_FAILURE, "Cannot replace the target");
+            return SSH_OK;
+        }
+    }
+    if (rename(oldpath, newpath) < 0) {
+        int saved_errno = errno;
+        if (aside[0])
+            rename(aside, newpath);                   /* put the target back */
+        return reply_errno(client_msg, saved_errno);
+    }
+    if (aside[0])
+        remove(aside);
+    if (newtype >= 0)
+        riscos_sftp_set_type(newpath, newtype);
+    sftp_reply_status(client_msg, SSH_FX_OK, NULL);
+    return SSH_OK;
+}
 
+static int
+process_rename_riscos(sftp_client_message client_msg)
+{
+    return do_rename(client_msg, 0);
+}
+
+static int
+process_posix_rename_riscos(sftp_client_message client_msg)
+{
+    return do_rename(client_msg, 1);
+}
